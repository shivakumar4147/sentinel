# =====================================================================
# SENTINEL - ROOT ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env for local deployment. NEVER commit actual .env with secrets.
# =====================================================================

# Global Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api

# Database Configuration (PostgreSQL)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secure_password_replace_in_prod
POSTGRES_DB=sentinel_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sentinel:sentinel_secure_password_replace_in_prod@postgres:5432/sentinel_db

# Frontend Service
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# Ollama AI Engine (Member 3)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_MOCK_MODE=True
OLLAMA_TIMEOUT_SECONDS=30

# Safety Policy Engine & Remediation
SAFETY_DRY_RUN=True
REQUIRE_HUMAN_APPROVAL_FOR_MEDIUM=True
REQUIRE_HUMAN_APPROVAL_FOR_HIGH=True
AUTO_REMEDIATION_ENABLED=False

# Monitoring & Prometheus (Member 4)
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://prometheus:9090

# Demo Application (Member 4)
DEMO_API_PORT=5000
DEMO_WORKER_PORT=5001

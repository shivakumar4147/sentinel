# =====================================================================
# SENTINEL BACKEND ENVIRONMENT (.env.example)
# =====================================================================

ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (defaults to local sqlite for zero-dependency test if postgres not ready)
DATABASE_URL=sqlite:///./sentinel.db
# For PostgreSQL:
# DATABASE_URL=postgresql://sentinel:sentinel_password@localhost:5432/sentinel_db

# AI Integration (Member 3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_MOCK_MODE=True
OLLAMA_TIMEOUT_SECONDS=30

# Safety Policy Engine
SAFETY_DRY_RUN=True
REQUIRE_HUMAN_APPROVAL_FOR_MEDIUM=True
REQUIRE_HUMAN_APPROVAL_FOR_HIGH=True
WHITELISTED_ACTIONS=restart_container,rollback_deployment,scale_replicas,clear_cache,check_database_connectivity,isolate_traffic

# Prometheus Monitoring (Member 4)
PROMETHEUS_URL=http://localhost:9090

# Docker Integration (Read-Only)
MOCK_SERVICES_FALLBACK=False
DOCKER_TIMEOUT_SECONDS=5

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

